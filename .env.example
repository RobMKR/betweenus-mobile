# Loopback local demo; physical devices require a reachable authenticated HTTPS API.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Demo identity controls are visible only when this is true. Backend must also enable demo auth.
EXPO_PUBLIC_DEMO_MODE=false
# Public client configuration; never use a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
