{
  "expo": {
    "name": "BetweenUs",
    "slug": "betweenus",
    "scheme": "betweenus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.betweenus.mobile"
    },
    "android": {
      "package": "com.betweenus.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#174E3D"
      },
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/badge.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F3"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Choose people to save in BetweenUs. Only selected contact details are kept."
        }
      ]
    ],
    "owner": "RobMKR"
  }
}
